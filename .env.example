# Deno Case 环境变量配置示例

# HMAC 验签秘钥 (用于 /api/crypto-sign 接口)
SECRET_KEY=deno-default-secret-key-2026

# 服务监听端口 (部署于 Deno Deploy 时由系统自动分配)
PORT=8000

# 🤖 AI 边缘网关配置 (Phase 1)
# 大模型 API Key (支持 DeepSeek / OpenAI / SiliconFlow / 零一万物等)
AI_API_KEY=your_deepseek_or_openai_api_key_here

# 大模型 API Base URL (默认使用 DeepSeek 官方接口地址)
AI_BASE_URL=https://api.deepseek.com

# 默认使用的模型名称 (如 deepseek-chat 或 gpt-4o-mini)
AI_MODEL=deepseek-chat

# 🔐 页面访问保护密码 (设置后访问网页需要输入密码解密控制台，留空默认密码为 deno2026)
APP_PASSWORD=deno2026
